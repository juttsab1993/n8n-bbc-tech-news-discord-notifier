      "name": "Discord",
      "webhookId": "6b94647a-f2d3-4b77-95d4-74fe3a9bd5a0"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "output_items = []\n\n# Pehle item ka main data lena\nraw_data = _items[0]\n\n# Agar data 'json' key ke andar band ho to usay open karein\nif isinstance(raw_data, dict) and 'json' in raw_data:\n    actual_data = raw_data['json']\nelse:\n    actual_data = raw_data\n\n# RSS se Channel aur wahan se Item list nikalna\nchannel_data = actual_data.get('rss', {}).get('channel', {})\nnews_list = channel_data.get('item', [])\n\n# Agar sirf single news ho to usay bhi list bana lein\nif isinstance(news_list, dict):\n    news_list = [news_list]\n\n# Har news ko loop mein process karna\nfor news in news_list:\n    if isinstance(news, dict):\n        news_item = {\n            \"title\": news.get('title', ''),\n            \"link\": news.get('link', '')\n        }\n        output_items.append({\"json\": news_item})\n\nreturn output_items"
      },
      "type": "n8n-nodes-base.code",
