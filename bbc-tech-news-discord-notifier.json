      ],
      "id": "bb5cc03c-e1c7-4eb5-966d-f912a87236e4",
      "name": "Merge",
      "executeOnce": false,
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "saved_links = set()\nnews_list = []\n\n# Sheet ke records aur feed ki khabrein alag karna\nfor item in _items:\n    data = item.get(\"json\", {})\n\n    # Sheet mein column ka naam capital L wala Link hai\n    if \"Link\" in data:\n        link = str(data.get(\"Link\") or \"\").strip()\n        if link:\n            saved_links.add(link)\n\n    # Pehle Python se small l wala link aata hai\n    elif \"link\" in data:\n        news_list.append(data)\n\noutput_items = []\n\n# Har khabar ko purane links se compare karna\nfor news in news_list:\n    link = str(news.get(\"link\") or \"\").strip()\n\n    if not link or link in saved_links:\n        continue\n\n    output_items.append({\n        \"json\": {\n            \"title\": news.get(\"title\", \"\"),\n            \"link\": link\n        }\n    })\n\n    # Isi feed mein duplicate link dobara na nikle\n    saved_links.add(link)\n\nreturn output_items"
      },
      "type": "n8n-nodes-base.code",
